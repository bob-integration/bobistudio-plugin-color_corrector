{
  "license": "GPL-3.0-or-later",
  "type": "color_corrector",
  "label": "Correcteur",
  "runtime": "docker",
  "badge": {
    "label": "Correcteur",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.13.0",
  "video_format": false,
  "adapts_input": true,
  "description": "Correcteur de couleur vidéo (luma/chroma + color balance + glow/bloom) appliqué à chaud sur un flux du pipeline MXL.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/correcteurs",
    "order": 30
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "input_shm": null,
    "cc_params": {},
    "genlock": true,
    "log_level": "info"
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_cc"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "state_field": "input_shm",
        "label": "Source vidéo"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/state",
      "/params",
      "/reset",
      "/input",
      "/log_level"
    ],
    "recall": {
      "source": "plugin_store",
      "scope": "global",
      "endpoint": "/params"
    },
    "read_endpoints": [
      "/state"
    ]
  },
  "param_tree": {
    "global_groups": [
      {
        "label": "Luminance",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "brightness": {
            "label": "Luminosité",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "contrast": {
            "label": "Contraste",
            "type": "scale",
            "min": 0,
            "max": 2,
            "default": 1
          },
          "gamma": {
            "label": "Gamma",
            "type": "scale",
            "min": 0.1,
            "max": 10,
            "default": 1
          }
        }
      },
      {
        "label": "Couleur",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "saturation": {
            "label": "Saturation",
            "type": "scale",
            "min": 0,
            "max": 3,
            "default": 1
          },
          "hue": {
            "label": "Teinte",
            "type": "angle",
            "min": -180,
            "max": 180,
            "default": 0
          }
        }
      },
      {
        "label": "Gamma par canal",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "gamma_r": {
            "label": "Gamma R",
            "type": "scale",
            "min": 0.1,
            "max": 10,
            "default": 1
          },
          "gamma_g": {
            "label": "Gamma V",
            "type": "scale",
            "min": 0.1,
            "max": 10,
            "default": 1
          },
          "gamma_b": {
            "label": "Gamma B",
            "type": "scale",
            "min": 0.1,
            "max": 10,
            "default": 1
          }
        }
      },
      {
        "label": "Glow / Bloom",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "glow_enabled": {
            "label": "Actif",
            "type": "bool",
            "default": true
          },
          "glow": {
            "label": "Intensité",
            "type": "scale",
            "min": 0,
            "max": 2,
            "default": 0
          },
          "glow_thresh": {
            "label": "Seuil",
            "type": "ratio",
            "min": 0,
            "max": 1,
            "default": 0.7
          },
          "glow_radius": {
            "label": "Rayon",
            "type": "pixels",
            "min": 1,
            "max": 64,
            "default": 8
          }
        }
      },
      {
        "label": "Balance — Ombres",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "cb_rs": {
            "label": "Rouge",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_gs": {
            "label": "Vert",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_bs": {
            "label": "Bleu",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          }
        }
      },
      {
        "label": "Balance — Tons moyens",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "cb_rm": {
            "label": "Rouge",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_gm": {
            "label": "Vert",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_bm": {
            "label": "Bleu",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          }
        }
      },
      {
        "label": "Balance — Lumières",
        "endpoint": "/params",
        "path_prefix": "params",
        "fields": {
          "cb_rh": {
            "label": "Rouge",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_gh": {
            "label": "Vert",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          },
          "cb_bh": {
            "label": "Bleu",
            "type": "number",
            "min": -1,
            "max": 1,
            "default": 0
          }
        }
      },
      {
        "label": "Journal (diagnostic)",
        "endpoint": "/log_level",
        "fields": {
          "level": {
            "label": "Niveau de log",
            "type": "enum",
            "options": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "path": "log_level"
          }
        }
      }
    ]
  },
  "store": {
    "scope": "global",
    "unique_name": true
  },
  "actions": [
    {
      "id": "reset",
      "label": "Réinitialiser la correction",
      "endpoint": "/reset",
      "params": []
    },
    {
      "id": "set_params",
      "label": "Régler la correction (champs vides = inchangés)",
      "endpoint": "/params",
      "params": [
        {
          "key": "brightness",
          "label": "Luminosité (-1..1)",
          "type": "number",
          "optional": true
        },
        {
          "key": "contrast",
          "label": "Contraste (0..2)",
          "type": "number",
          "optional": true
        },
        {
          "key": "saturation",
          "label": "Saturation (0..3)",
          "type": "number",
          "optional": true
        },
        {
          "key": "gamma",
          "label": "Gamma (0.1..10)",
          "type": "number",
          "optional": true
        },
        {
          "key": "hue",
          "label": "Teinte (deg, -180..180)",
          "type": "number",
          "optional": true
        }
      ]
    },
    {
      "id": "log_level",
      "label": "Niveau de log (à chaud)",
      "endpoint": "/log_level",
      "params": [
        {
          "key": "level",
          "label": "Niveau",
          "type": "text",
          "default": "info",
          "options": [
            {
              "value": "debug",
              "label": "Détaillé"
            },
            {
              "value": "info",
              "label": "Événements (défaut)"
            },
            {
              "value": "warning",
              "label": "Anomalies seules"
            },
            {
              "value": "error",
              "label": "Erreurs seules"
            }
          ]
        }
      ]
    }
  ],
  "state": [
    {
      "id": "saturation",
      "label": "Saturation",
      "endpoint": "/state",
      "path": "params.saturation",
      "type": "number"
    },
    {
      "id": "brightness",
      "label": "Luminosité",
      "endpoint": "/state",
      "path": "params.brightness",
      "type": "number"
    }
  ],
  "config_schema": [
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. Exige le genlock (verrou-entrée 1:1) et une entrée progressive.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    }
  ]
}
