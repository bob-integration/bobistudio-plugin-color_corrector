{
  "license": "GPL-3.0-or-later",
  "type": "color_corrector",
  "label": "Correcteur",
  "runtime": "docker",
  "badge": {
    "label": "Correcteur",
    "class": "mode-corrector",
    "oklch": "0.80 0.05 110"
  },
  "version": "0.7.0",
  "video_format": false,
  "adapts_input": true,
  "description": "Correcteur de couleur vidéo (luma/chroma + color balance + glow/bloom) appliqué à chaud sur un flux du pipeline MXL.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/correcteurs",
    "order": 30
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "input_shm": null,
    "cc_params": {},
    "genlock": true
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_cc"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "state_field": "input_shm",
        "label": "Source vidéo"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "endpoints": [
      "/state",
      "/params",
      "/reset",
      "/input"
    ],
    "recall": {
      "source": "plugin_store",
      "scope": "global",
      "endpoint": "/params"
    }
  },
  "store": {
    "scope": "global",
    "unique_name": true
  },
  "actions": [
    {
      "id": "reset",
      "label": "Réinitialiser la correction",
      "endpoint": "/reset",
      "params": []
    },
    {
      "id": "set_params",
      "label": "Régler la correction (champs vides = inchangés)",
      "endpoint": "/params",
      "params": [
        {
          "key": "brightness",
          "label": "Luminosité (-1..1)",
          "type": "number",
          "optional": true
        },
        {
          "key": "contrast",
          "label": "Contraste (0..2)",
          "type": "number",
          "optional": true
        },
        {
          "key": "saturation",
          "label": "Saturation (0..3)",
          "type": "number",
          "optional": true
        },
        {
          "key": "gamma",
          "label": "Gamma (0.1..10)",
          "type": "number",
          "optional": true
        },
        {
          "key": "hue",
          "label": "Teinte (deg, -180..180)",
          "type": "number",
          "optional": true
        }
      ]
    }
  ],
  "state": [
    {
      "id": "saturation",
      "label": "Saturation",
      "endpoint": "/state",
      "path": "params.saturation",
      "type": "number"
    },
    {
      "id": "brightness",
      "label": "Luminosité",
      "endpoint": "/state",
      "path": "params.brightness",
      "type": "number"
    }
  ]
}
